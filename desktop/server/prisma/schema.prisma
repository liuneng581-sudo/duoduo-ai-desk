generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "windows"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================
// AUTH & USER
// ============================

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  passwordHash    String
  name            String
  avatarUrl       String?
  role            String    @default("user") // "user" | "admin"
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  stores          Store[]
  apiKeys         ApiKey[]
  imageGenerations ImageGeneration[]
}

// ============================
// STORE (Pinduoduo store)
// ============================

model Store {
  id          String   @id @default(cuid())
  userId      String
  name        String                           // Store display name
  shopId      String?                          // Pinduoduo shop ID
  description String?
  status      String   @default("active")       // "active" | "paused" | "closed"

  // Login credentials (encrypted, for auto-login)
  loginAccount  String?                          // Encrypted PDD login account
  loginPassword String?                          // Encrypted PDD login password

  // Browser automation session
  cookieData  String?                          // Encrypted cookie JSON for Playwright
  cookieExpiresAt DateTime?
  browserState String  @default("idle")        // "idle" | "connecting" | "online" | "error" | "needs_login" | "needs_captcha"

  // AI auto-reply controls
  aiEnabled          Boolean @default(true)     // Master switch: when false, AI never auto-replies (messages still logged)
  aiPauseOnSensitive Boolean @default(true)     // Hand off to human on sensitive scenes (active refund / dispute) instead of auto-replying

  lastConnectedAt DateTime?                     // 最后连接时间（companion 上线时更新）

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  customers        Customer[]
  products         Product[]
  orders           Order[]
  conversations    Conversation[]
  imageGenerations ImageGeneration[]
  qaEntries        QAEntry[]

  @@unique([userId, shopId])
  @@index([userId])
}

// ============================
// CUSTOMERS
// ============================

model Customer {
  id          String   @id @default(cuid())
  storeId     String
  externalId  String?                          // Pinduoduo customer ID
  name        String?
  phone       String?
  wechatId    String?
  address     String?                          // JSON: default shipping address
  tags        String?                          // JSON: ["vip", "frequent_returner"]
  totalOrders Int      @default(0)
  totalSpent  Float    @default(0)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  store         Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  orders        Order[]

  @@unique([storeId, externalId])
  @@index([storeId])
  @@index([phone])
}

// ============================
// PRODUCTS
// ============================

model Product {
  id          String   @id @default(cuid())
  storeId     String
  externalId  String?                          // Pinduoduo product ID (parsed from productUrl for dedup)
  name        String
  description String?                 // Full product description (AI context)
  price       Float
  stock       Int      @default(0)
  category    String?
  productUrl  String?                          // PDD product link — sent as plain text in chat, PDD auto-renders it as a product card
  imageUrls   String?                          // JSON array of image URLs
  freight     String?                          // 运费说明 (e.g. "包邮" / "满99包邮 / 首重8元")
  material    String?                          // 材质 (e.g. "纯棉" / "不锈钢304")
  specs       String?                          // 规格 (e.g. "200ml / 500ml" / JSON)
  shippingTime String?                         // 发货时效 (e.g. "48小时内发货" / "现货当天发")
  lastSyncedAt DateTime?                       // 最后同步时间
  status      String   @default("on_sale")     // "on_sale" | "off_sale" | "deleted"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  store            Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  orderItems       OrderItem[]
  imageGenerations ImageGeneration[]

  @@unique([storeId, externalId])
  @@index([storeId])
  @@index([storeId, category])
}

// ============================
// Q&A KNOWLEDGE BASE
// ============================
// Store-scoped question/answer pairs the AI consults before replying. Unlike
// Product (catalog facts), these are policy/service answers: "开通退货包运费吗",
// "支持几天无理由", "发什么快递". Each entry is one canonical answer the AI
// should give for a recurring question, so店家 can curate exact wording.

model QAEntry {
  id         String   @id @default(cuid())
  storeId    String
  question   String                              // The canonical customer question
  answer     String                              // The answer the AI should base its reply on
  keywords   String?                             // Optional comma/space-separated match hints ("退货包运费 运费险")
  category   String?                             // Optional grouping ("售后" | "物流" | "活动" …)
  enabled    Boolean  @default(true)             // Soft on/off without deleting
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@index([storeId, enabled])
}

// ============================
// ORDERS
// ============================

model Order {
  id              String   @id @default(cuid())
  storeId         String
  customerId      String?
  externalId      String?                      // Pinduoduo order ID
  status          String   @default("pending") // "pending"|"paid"|"shipped"|"delivered"|"completed"|"refunded"|"cancelled"
  totalAmount     Float
  paymentMethod   String?
  shippingAddress String?
  trackingNumber  String?
  paidAt          DateTime?
  shippedAt       DateTime?
  deliveredAt     DateTime?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  store      Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer   Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items      OrderItem[]

  @@unique([storeId, externalId])
  @@index([storeId])
  @@index([storeId, status])
  @@index([customerId])
}

model OrderItem {
  id        String @id @default(cuid())
  orderId   String
  productId String?
  name      String
  price     Float
  quantity  Int
  imageUrl  String?

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
}

// ============================
// AI CHAT CONVERSATIONS & MESSAGES
// ============================

model Conversation {
  id         String   @id @default(cuid())
  storeId    String
  customerId String?                             // Link to a known customer
  context    String   @default("presale")        // "presale" | "insale" | "aftersale"
  title      String?                             // Auto-generated summary
  status     String   @default("active")         // "active" | "resolved" | "archived"
  orderSn    String?                             // PDD order number linked to this conversation (from chat/order cards)
  relatedGoodsIds String?                        // JSON array of goods_id this customer asked about / bought
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  store    Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  messages Message[]

  @@index([storeId])
  @@index([storeId, context])
  @@index([customerId])
  @@index([orderSn])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  role           String                           // "user" | "assistant" | "system"
  content        String                   // Full message text
  tokenCount     Int      @default(0)
  metadata       String?                            // {model, finishReason, latency, ...}
  externalMsgId  String?  @unique                    // PDD msg_id for inbound dedup (idempotency)
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

// ============================
// AI IMAGE GENERATION
// ============================

model ImageGeneration {
  id             String   @id @default(cuid())
  userId         String
  storeId        String?                           // Which store used for
  productId      String?                           // Which product the image is for
  mode           String   @default("text2img")     // "text2img" | "img2img"
  prompt         String
  sourceImageUrl String?
  resultUrls     String?                           // JSON array of generated image URLs
  provider       String   @default("openai")       // "openai" | "midjourney"
  modelVersion   String?                           // "dall-e-3" etc
  parameters     String?                             // {size, quality, style, n, ...}
  status         String   @default("pending")      // "pending" | "completed" | "failed"
  error          String?
  createdAt      DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  store   Store?   @relation(fields: [storeId], references: [id], onDelete: SetNull)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([storeId])
  @@index([userId, createdAt(sort: Desc)])
}

// ============================
// API KEYS (encrypted)
// ============================

model ApiKey {
  id        String   @id @default(cuid())
  userId    String
  provider  String                              // "openai" | "anthropic" | "midjourney"
  label     String                              // User-given name
  keyHash   String                              // AES-256-CBC encrypted API key
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider, label])
  @@index([userId])
}

// ============================
// SYSTEM SETTINGS
// ============================

model SystemConfig {
  id        String   @id @default(cuid())
  userId    String
  key       String                                // e.g. "feishu_webhook_url", "default_ai_provider"
  value     String                        // The config value
  updatedAt DateTime @updatedAt

  @@unique([userId, key])
  @@index([userId])
}

// ============================
// ANNOUNCEMENTS (软件内公告/远程推送)
// ============================

model Announcement {
  id          String   @id @default(cuid())
  title       String                              // 公告标题
  content     String                              // 公告正文（支持简单 markdown）
  level       String   @default("info")           // "info" | "warning"
  publishedAt DateTime @default(now())            // 发布时间
  active      Boolean  @default(true)             // 是否启用

  @@index([active, publishedAt(sort: Desc)])
}
