# ========== Database ==========
DATABASE_URL="file:./prisma/pdd-ai-manager.db"

# ========== JWT ==========
JWT_ACCESS_SECRET="local-dev-access-secret-change-me"
JWT_REFRESH_SECRET="local-dev-refresh-secret-change-me"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
COMPANION_WS_TOKEN="local-dev-companion-token"

# ========== API Key Encryption ==========
API_KEY_ENCRYPTION_KEY="local-dev-api-key-encryption-secret"

# ========== Server ==========
PORT=3001
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ========== AI Providers ==========
# Claude (Anthropic)
ANTHROPIC_API_KEY="sk-ant-..."

# OpenAI
OPENAI_API_KEY="sk-..."

# ========== Pinduoduo ==========
# Playwright browser mode: "headless" | "headful"
PDD_BROWSER_MODE="headful"
PDD_BROWSER_COUNT=3
PDD_USER_DATA_DIR="./browser-data"

# ========== Local admin (desktop server only) ==========
# Optional. First-run login for admin@pdd-ai.com.
# Leave empty to generate a random password and print it once in the server log.
# There is no public default password. Known defaults, placeholders, and
# (when NODE_ENV is not development) passwords shorter than 12 characters
# are rejected and the server will not start.
SEED_ADMIN_PASSWORD=

# ========== Support contact (baked into the client at build time) ==========
# Public URL shown on the activation page and the in-app support dialog.
# Leave empty to hide the link. Do not commit a personal invite token.
# Vite reads this file from the desktop/ directory.
VITE_SUPPORT_CONTACT_URL=
# Optional public image URL for a support QR code. Leave empty for the placeholder.
VITE_SUPPORT_QR_IMAGE_URL=
