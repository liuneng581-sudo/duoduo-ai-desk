# 复制为进程环境变量或本地 .env（.env 已被 gitignore，不要提交真实值）。
# license-server 在 ADMIN_EMAIL / ADMIN_PASSWORD 缺失或密码过弱时会拒绝启动。

# 必填。签发正式授权时使用的超管邮箱。
ADMIN_EMAIL=admin@example.com

# 必填。至少 12 位的随机强密码。
# 未设置、短于 12 位、占位符、常见弱口令，或历史公开默认口令（含简单拼接）都会导致进程退出。
# 不要把真实密码写进仓库。
ADMIN_PASSWORD=

# 可选。
PORT=4010
# 默认只监听本机，由 nginx 反代对外。
BIND_HOST=127.0.0.1
# Ed25519 私钥路径。文件权限应为 600，且不要提交到 git。
LICENSE_PRIVATE_KEY=./license-private.key
LICENSE_DB=./data/license.db
